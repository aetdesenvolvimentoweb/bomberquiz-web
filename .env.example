# Vazio = usa o proxy do Vite dev server (server.proxy em vite.config.ts) contra
# http://localhost:3000, evitando o problema de cookie cross-origin em dev (SameSite=Lax
# não é enviado em fetch cross-site fora de navegação top-level). Em produção, defina a
# URL absoluta do backend implantado (ex.: https://api.bomberquiz.com.br).
VITE_API_BASE_URL=https://api.bomberquiz.com.br

# Monitoramento de erro (ADR-0031, opcional) — vazio = SDK não inicializa.
# Free tier em sentry.io cobre o estágio atual do produto (~5k eventos/mês).
VITE_SENTRY_DSN=

# Chave PÚBLICA do Mercado Pago (Módulo 6, Fatia 5) — usada pelo Card Payment
# Brick para tokenizar cartão no navegador. Vazio = opção de pagamento por
# cartão fica desabilitada na tela de planos; PIX continua funcionando.
# É pública por natureza (embutida no bundle), nunca use o Access Token aqui.
VITE_MP_PUBLIC_KEY=
